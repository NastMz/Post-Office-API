driver = mysql
connect = host=${DB_HOST} dbname=${DB_NAME} user=mailserver password=${MAILSERVER_DB_PASSWORD}
default_pass_scheme = BLF-CRYPT
password_query = SELECT email AS user, password FROM users WHERE email = '%u'
user_query = SELECT 5000 AS uid, 5000 AS gid, CONCAT('/var/mail/vhosts/', '%d', '/', '%n') AS home FROM users WHERE email = '%u'
iterate_query = SELECT email AS user FROM users
