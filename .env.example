# Copy to .env and replace every value before exposing the stack.
# The API refuses the public development secrets unless APP_ENV=development,
# which docker-compose.yml sets by default. Remove it (or set production)
# once real secrets are in place, e.g. generated with: openssl rand -hex 32
APP_ENV=production
MAIL_DOMAIN=postoffice.test
JWT_SECRET=change-me-to-a-long-random-string
MAIL_MASTER_PASSWORD=change-me
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
MAILSERVER_DB_PASSWORD=change-me
SEED_DEMO_DATA=false
# Requests per client IP on /api/auth/login and /api/auth/register.
AUTH_RATE_LIMIT=10 per minute
